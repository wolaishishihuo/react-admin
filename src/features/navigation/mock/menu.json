{
  "code": 200,
  "data": {
    "home": "/home",
    "routes": [
      {
        "path": "/home",
        "handle": {
          "title": "首页",
          "icon": "ri:home-smile-2-line",
          "keepAlive": false,
          "fixedIndexInTab": 0,
          "order": 1
        }
      },
      {
        "path": "/list",
        "redirect": "/list/useProTable",
        "handle": {
          "title": "列表页面",
          "icon": "ri:table-line",
          "order": 2
        },
        "children": [
          {
            "path": "/list/useProTable",
            "handle": {
              "title": "用户列表",
              "icon": "ri:apps-line",
              "keepAlive": true,
              "buttons": ["add", "edit", "delete", "batchDelete", "status"]
            }
          },
          {
            "path": "/list/useProTable/detail",
            "handle": {
              "title": "用户详情",
              "icon": "ri:file-list-3-line",
              "hideInMenu": true,
              "keepAlive": true,
              "multiTab": true,
              "activeMenu": "/list/useProTable"
            }
          },
          {
            "path": "/users/:userId",
            "handle": {
              "title": "用户资料",
              "icon": "ri:user-3-line",
              "hideInMenu": true,
              "keepAlive": false,
              "activeMenu": "/list/useProTable"
            }
          }
        ]
      },
      {
        "path": "/iframe/:url",
        "handle": {
          "title": "内嵌页面",
          "hideInMenu": true,
          "keepAlive": true,
          "multiTab": true
        }
      }
    ]
  },
  "msg": "成功"
}
