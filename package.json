{
  "name": "react-admin",
  "version": "1.0.0",
  "private": true,
  "description": "React Admin management system",
  "homepage": "https://github.com/wolaishishihuo/react-admin",
  "bugs": {
    "url": "https://github.com/wolaishishihuo/react-admin/issues"
  },
  "license": "MIT",
  "author": {
    "name": "wolaishishihuo",
    "email": "2430250298@qq.com",
    "url": "https://github.com/wolaishishihuo"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:wolaishishihuo/react-admin.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --mode development",
    "build:test": "tsc && vite build --mode test",
    "build:pro": "tsc && vite build --mode production",
    "type:check": "tsc --noEmit --skipLibCheck",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "pnpm build:dev && vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint:lint-staged": "lint-staged",
    "prepare": "husky",
    "commit": "git add -A && czg && git push"
  },
  "dependencies": {
    "@ant-design/happy-work-theme": "^2.0.0",
    "@ant-design/pro-components": "3.1.15-6",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/react": "^6.0.2",
    "@tanstack/react-query": "^5.104.1",
    "ahooks": "^3.10.0",
    "antd": "^6.6.5",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "echarts": "6.1.0",
    "immer": "^11.1.21",
    "md5": "^2.3.0",
    "nprogress": "^0.2.0",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-countup": "^6.5.3",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/md5": "^2.3.6",
    "@types/node": "^22.20.5",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unocss/eslint-plugin": "^66.13.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cz-git": "^1.14.0",
    "czg": "^1.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~5.9.3",
    "unocss": "^66.10.5",
    "vite": "^8.3.7",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^4.1.11"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "browserslist": {
    "production": [
      "> 1%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
