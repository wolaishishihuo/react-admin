{
  "name": "hooks-admin",
  "version": "1.0.0",
  "private": true,
  "description": "hooks-admin open source management system",
  "homepage": "https://github.com/wolaishishihuo/react-admin",
  "bugs": {
    "url": "https://github.com/wolaishishihuo/react-admin/issues"
  },
  "license": "MIT",
  "author": {
    "name": "wolaishishihuo",
    "email": "2430250298@qq.com",
    "url": "https://github.com/wolaishishihuo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wolaishishihuo/react-admin.git"
  },
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "serve": "vite",
    "build:dev": "tsc && vite build --mode development",
    "build:test": "tsc && vite build --mode test",
    "build:pro": "tsc && vite build --mode production",
    "type:check": "tsc --noEmit --skipLibCheck",
    "preview": "pnpm build:dev && vite preview",
    "icons:build": "node scripts/extract-icons.mjs",
    "routes:generate": "vite build --mode development",
    "routes:check": "pnpm routes:generate && node scripts/check-route-tree.mjs",
    "lint:check": "eslint \"{src,tests}/**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"*.{js,jsx,ts,tsx,json,css,less,scss,html,md,cjs,mjs,yml,yaml}\" \"{src,build,docs,tests}/**/*.{js,jsx,ts,tsx,json,css,less,scss,html,md,cjs,mjs,yml,yaml}\" \".{prettier,stylelint}rc.cjs\" \".github/workflows/*.{yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm routes:check && pnpm type:check && pnpm lint:check && pnpm format:check && pnpm test && PLAYWRIGHT_PORT=19528 PLAYWRIGHT_REUSE_SERVER=false pnpm test:e2e && VITE_ROUTER_MODE=history PLAYWRIGHT_PORT=19529 PLAYWRIGHT_REUSE_SERVER=false pnpm test:e2e && VITE_AUTH_ROUTE_MODE=dynamic PLAYWRIGHT_PORT=19530 PLAYWRIGHT_REUSE_SERVER=false pnpm exec playwright test tests/e2e/cache.spec.ts tests/e2e/auth.spec.ts && pnpm build:pro && VITE_ROUTER_MODE=history pnpm build:dev",
    "lint:eslint": "eslint --fix \"{src,tests}/**/*.{js,jsx,ts,tsx}\"",
    "lint:prettier": "prettier --write \"*.{js,jsx,ts,tsx,json,css,less,scss,html,md,cjs,mjs,yml,yaml}\" \"{src,build,docs,tests}/**/*.{js,jsx,ts,tsx,json,css,less,scss,html,md,cjs,mjs,yml,yaml}\" \".{prettier,stylelint}rc.cjs\" \".github/workflows/*.{yml,yaml}\"",
    "lint:stylelint": "stylelint --cache --fix \"src/**/*.{less,postcss,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "lint:lint-staged": "lint-staged",
    "prepare": "[ -d .git ] && husky || true",
    "commit": "czg"
  },
  "dependencies": {
    "@ant-design/happy-work-theme": "^2.0.0",
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "3.1.14-2",
    "@iconify/react": "^6.0.2",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "1.162.8",
    "ahooks": "^3.9.7",
    "antd": "^6.5.0",
    "axios": "^1.18.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "motion": "12.34.3",
    "nprogress": "^0.2.0",
    "react": "^19.2.7",
    "react-colorful": "^5.6.1",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@eslint/js": "^10.0.1",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/utils": "^3.1.4",
    "@playwright/test": "^1.62.1",
    "@tanstack/router-plugin": "1.162.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.9",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@unocss/eslint-plugin": "^66.7.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.19",
    "cz-git": "^1.9.3",
    "czg": "^1.9.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.0.11",
    "jsdom": "^27.4.0",
    "less": "^4.2.0",
    "lint-staged": "^15.2.7",
    "postcss": "^8.4.39",
    "postcss-html": "^1.7.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "^16.6.1",
    "stylelint-config-recess-order": "^5.0.1",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "unocss": "^66.7.2",
    "vite": "^8.0.16",
    "vite-plugin-checker": "^0.14.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^4.1.11"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "browserslist": {
    "production": [
      "> 1%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.26.0"
  },
  "packageManager": "pnpm@10.26.0"
}
