{
  "name": "react-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React Admin management system",
  "author": {
    "name": "wolaishishihuo",
    "email": "2430250298@qq.com",
    "url": "https://github.com/wolaishishihuo"
  },
  "license": "MIT",
  "homepage": "https://github.com/wolaishishihuo/react-admin",
  "repository": {
    "type": "git",
    "url": "git@github.com:wolaishishihuo/react-admin.git"
  },
  "bugs": {
    "url": "https://github.com/wolaishishihuo/react-admin/issues"
  },
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build:dev": "tsc && vite build --mode development",
    "build:test": "tsc && vite build --mode test",
    "build:pro": "tsc && vite build --mode production",
    "type:check": "tsc --noEmit --skipLibCheck",
    "preview": "npm run build:dev && vite preview",
    "lint:eslint": "eslint --fix ./src",
    "lint:prettier": "prettier --write --log-level warn \"src/**/*.{js,ts,json,tsx,css,less,scss,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:lint-staged": "lint-staged",
    "prepare": "husky",
    "release": "standard-version",
    "commit": "git add -A && czg && git push"
  },
  "dependencies": {
    "@ant-design/happy-work-theme": "^2.0.0",
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "3.1.14-6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "ahooks": "^3.9.7",
    "antd": "^6.6.1",
    "axios": "^1.19.0",
    "dayjs": "^1.11.23",
    "echarts": "^5.6.0",
    "echarts-liquidfill": "^3.1.0",
    "immer": "^11.1.18",
    "md5": "^2.3.0",
    "nprogress": "^0.2.0",
    "qs": "^6.15.3",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "react-transition-group": "^4.4.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/md5": "^2.3.6",
    "@types/node": "^22.20.1",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "cz-git": "^1.14.0",
    "czg": "^1.14.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "less": "^4.9.0",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "unocss": "^66.8.1",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svg-icons": "^2.0.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "10"
      }
    }
  },
  "browserslist": {
    "production": [
      "> 1%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
