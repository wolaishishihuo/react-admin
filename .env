# title
VITE_GLOB_APP_TITLE = Hooks Admin

# Local running port number
VITE_PORT = 9527

# Open browser automatically on startup
VITE_OPEN = true

# Whether to generate a package analysis file after packaging
VITE_REPORT = false

# Route mode: static | dynamic
# static: no menu API; sidebar from local staticData
# dynamic: fetch current-user menu after login
VITE_AUTH_ROUTE_MODE = static
